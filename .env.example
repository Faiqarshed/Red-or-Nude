# Copy to .env.local and fill in. .env* is gitignored.

# Postgres. Supabase → Project Settings → Database → Connection string (URI).
# Use the session pooler (port 5432) for migrations, the transaction pooler
# (port 6543) for the app if you deploy serverless.
DATABASE_URL=postgresql://postgres:password@localhost:5432/red_or_nude

# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET=
# Required in production; the canonical origin of the admin.
AUTH_URL=http://localhost:3000

# Seed script — the first owner account it creates.
SEED_OWNER_EMAIL=owner@redornude.com
SEED_OWNER_PASSWORD=

# Media storage. Without these, uploads fall back to the local filesystem
# (/public/uploads) — fine for development, NOT for a serverless deploy.
# Supabase → Project Settings → API. The service role key is server-only: it
# bypasses row-level security, so it must never reach the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media

# Figma asset export script (scripts/fetch-assets.mjs)
FIGMA_TOKEN=

# Messaging. Without a driver, lib/notify/log.ts prints what would have been
# sent and nothing reaches a customer — including the booking reference they
# need for /my-bookings. See docs/REFILL-AND-GIFT-CARDS.md part 3.
NOTIFY_DRIVER=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Guards /api/cron/refill-reminders, which is otherwise a public URL that
# messages the whole customer list. Sent as: Authorization: Bearer <secret>
CRON_SECRET=

# Mail. Invoices and gift cards go out over SMTP (lib/email/smtp.ts).
# Works with Gmail, Zoho, Brevo, Mailjet or any relay.
#
# Gmail: host smtp.gmail.com, port 587, user the full address, and an App
# Password (Google Account → Security → 2-Step Verification → App passwords) —
# the normal account password will not work. Capped ~500 recipients/day. Google
# rewrites From to the authenticated mailbox, so MAIL_FROM_EMAIL must be that
# same address or a verified alias.
#
# Deliverability is about SPF/DKIM on the sending domain, not the transport.
# See docs/INVOICE-EMAIL.md §6.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Red or Nude
# Where a customer's reply lands. Optional; omit to leave replies going nowhere.
MAIL_REPLY_TO=

# Public origin of the customer-facing site. Emails embed absolute URLs (the
# gift card image), so without this they point at localhost and render broken
# in the recipient's inbox. Falls back to AUTH_URL, then localhost.
SITE_URL=https://redornude.com
