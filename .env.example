# Copy to .env.local and fill in. .env* is gitignored.

# Postgres. Supabase → Project Settings → Database → Connection string (URI).
# Use the session pooler (port 5432) for migrations, the transaction pooler
# (port 6543) for the app if you deploy serverless.
DATABASE_URL=postgresql://postgres:password@localhost:5432/red_or_nude

# Where every script under scripts/ runs. They are not read-only: the check
# scripts empty whole tables to build their fixtures, so pointed at a real
# database they delete real bookings. scripts/_test-db.ts refuses to start
# unless this is set, is on this machine, and names a database ending in _test.
#
#   createdb red_or_nude_test
#   npm run db:migrate:test
#   npm run db:seed
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/red_or_nude_test

# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET=
# Required in production; the canonical origin of the admin.
AUTH_URL=http://localhost:3000

# Skip the /admin login on this machine and act as the seeded CEO.
#
# Local convenience only, and it has to be asked for: without this set to
# exactly 1 the panel needs a real sign-in, whatever NODE_ENV happens to be.
# Never set it on a deployed box — it is an admin panel with no password.
ADMIN_DEV_LOGIN=1

# Seed script — the first owner account it creates.
SEED_OWNER_EMAIL=owner@redornude.com
SEED_OWNER_PASSWORD=

# Media storage. Without these, uploads fall back to the local filesystem
# (/public/uploads) — fine for development, NOT for a serverless deploy.
# Supabase → Project Settings → API. The service role key is server-only: it
# bypasses row-level security, so it must never reach the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media

# Figma asset export script (scripts/fetch-assets.mjs)
FIGMA_TOKEN=

# Messaging. Without a driver, lib/notify/log.ts prints what would have been
# sent and nothing reaches a customer — including the booking reference they
# need for /my-bookings. See docs/REFILL-AND-GIFT-CARDS.md part 3.
NOTIFY_DRIVER=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Guards /api/cron/refill-reminders, which is otherwise a public URL that
# messages the whole customer list. Sent as: Authorization: Bearer <secret>
CRON_SECRET=

# Mail. Invoices and gift cards go out over SMTP (lib/email/smtp.ts).
# Works with Gmail, Zoho, Brevo, Mailjet or any relay.
#
# Gmail: host smtp.gmail.com, port 587, user the full address, and an App
# Password (Google Account → Security → 2-Step Verification → App passwords) —
# the normal account password will not work. Capped ~500 recipients/day. Google
# rewrites From to the authenticated mailbox, so MAIL_FROM_EMAIL must be that
# same address or a verified alias.
#
# Deliverability is about SPF/DKIM on the sending domain, not the transport.
# See docs/INVOICE-EMAIL.md §6.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Red or Nude
# Where a customer's reply lands. Optional; omit to leave replies going nowhere.
MAIL_REPLY_TO=

# Public origin of the customer-facing site. Emails embed absolute URLs (the
# gift card image), so without this they point at localhost and render broken
# in the recipient's inbox. Falls back to AUTH_URL, then localhost.
SITE_URL=https://redornude.com


PAYMENT_DRIVER=moyasar
MOYASAR_PUBLISHABLE_KEY=pk_test_…
MOYASAR_SECRET_KEY=sk_test_…
MOYASAR_WEBHOOK_SECRET=…


# Gemini — powers the site chat assistant (app/api/chat).
# Key from Google AI Studio → aistudio.google.com/apikey. No card needed.
#
# Two things to know about the FREE tier, measured against this key:
#
#   1. It trains on what you send. Google's terms use prompts and responses to
#      improve their products and allow human review of both: "Do not submit
#      sensitive, confidential, or personal information to the Unpaid
#      Services." The knowledge block is salon-authored, but the transcript is
#      whatever a customer types.
#
#   2. Five requests per minute, for the whole project — not per visitor. Two
#      customers chatting at once is enough to hit it, and the third gets
#      "wait a minute". The route maps the upstream quota error to that
#      message rather than a generic failure, but only a paid tier raises the
#      ceiling.
#
# Both are lifted by enabling Cloud Billing on the key's Google Cloud project
# ("Upgrade to Paid" at aistudio.google.com/api-keys). It is pay-per-request
# with no monthly fee, and it needs no code change — the same key keeps working.
#
# Note a Google AI Pro subscription does NOT do this: that upgrades the AI
# Studio web playground, not the API, and is billed separately.
#
# Server-only. Never rename this with a NEXT_PUBLIC_ prefix — that ships the
# key into the browser bundle.
GEMINI_API_KEY=
